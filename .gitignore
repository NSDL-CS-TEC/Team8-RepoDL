# Ignore dataset contents, but preserve folder
data/*
!data/.gitkeep

# Large regenerable artifacts in results/ (train.py prepare rebuilds them). Everything
# else in results/ (CSV, *_scores.npz, logs/) is small and needed by evaluate.py.
results/ventanas.npz
results/imagenes_*.npy
results/*.pt

# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# Logs (training logs in results/logs/ are kept)
*.log
!results/logs/*.log

# LaTeX build files
report/**/*.aux
report/**/*.log
report/**/*.fls
report/**/*.fdb_latexmk
report/**/*.out
report/**/*.blg
report/**/*.nav
report/**/*.snm
report/**/*.toc

# LaTeX sources of the reports are kept locally, not in the repo
report/**/*.tex
report/**/*.bib
report/**/*.bbl

# Inputs of the local LaTeX build: only the PDFs are versioned in report/
report/01_reporte/generar_numeros.py
report/01_reporte/figures/
